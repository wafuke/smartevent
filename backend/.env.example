# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000

# Firebase (from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Africa's Talking (sandbox credentials while developing)
AT_USERNAME=sandbox
AT_API_KEY=

# ML prediction service (FastAPI, running locally in Step 5)
ML_SERVICE_URL=http://127.0.0.1:8000
